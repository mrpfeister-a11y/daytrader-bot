# Copy this file to ".env" and fill in your Alpaca PAPER keys.
# Get them at alpaca.markets -> Paper Trading -> API Keys.
# NEVER share this file or paste these keys into a chat.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper trading (fake money). Leave this as true.
ALPACA_PAPER=true
# Real money needs BOTH ALPACA_PAPER=false AND this set to yes. Don't, until
# paper trading has made money for at least a month.
I_UNDERSTAND_LIVE_TRADING_RISK=no

# Optional tweaks (defaults shown)
# POSITION_PCT=0.05
# MAX_GROSS_PCT=0.50
# DAILY_LOSS_LIMIT_PCT=0.02
# ENTRY_PROB=0.57
# ALLOW_SHORTS=true
